# MongoDB Atlas connection string (Atlas UI -> Connect -> Drivers -> Python)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
DB_NAME=volunteerops

# Luminal OpenAI-compatible endpoint
LLM_BASE_URL=https://<luminal-endpoint>/v1
LLM_API_KEY=<your-api-key>
LLM_MODEL=<model-name>

# Optional: where the pantry is, for weather forecasts (Open-Meteo, no key needed)
WEATHER_LAT=41.7004
WEATHER_LON=-73.9210
WEATHER_PLACE=Hudson Valley, NY

# Optional: demo-only features. NEXTUP_DEMO=1 shows a switch (coordinator account menu) that
# simulates bad weather on a chosen day. Leave unset to always use the real forecast.
# NEXTUP_DEMO=1

# Email notifications (sent only after a coordinator approves; delivered by notifier.py)
# EMAIL_PROVIDER: console (log only, default) | smtp | resend
EMAIL_PROVIDER=console
EMAIL_FROM=NextUp <noreply@yourdomain.org>
# Optional: send every email here instead of to volunteers (demos/staging)
EMAIL_REDIRECT_TO=
# Base URL used in the Accept/Decline link
APP_URL=http://localhost:8501
# Random secret for signing response links (e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`)
RESPONSE_LINK_SECRET=
# smtp provider
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# resend provider
RESEND_API_KEY=
